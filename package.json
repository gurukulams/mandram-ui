{
  "name": "hugo-rollup-project",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "dev": "npm-run-all --parallel watch:js serve:hugo",
    "watch:js": "rollup -c -w",
    "serve:hugo": "hugo server -s site --bind 0.0.0.0"
  },
  "devDependencies": {
    "glob": "^10.3.10",
    "npm-run-all": "^4.1.5",
    "rollup": "^4.0.0"
  }
}
