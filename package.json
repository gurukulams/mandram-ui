{
  "name": "hugo-rollup-project",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build:js": "rollup -c",
    "build:site": "hugo -s site",
    "build": "npm-run-all build:js build:site",
    "dev": "npm-run-all --parallel watch:js serve:hugo",
    "watch:js": "rollup -c -w",
    "serve:hugo": "hugo server -s site --themesDir ../.. --bind 0.0.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "glob": "^10.3.10",
    "npm-run-all": "^4.1.5",
    "rollup": "^4.0.0"
  },
  "dependencies": {
    "practice-js": "github:gurukulams/practice-js"
  }
}
